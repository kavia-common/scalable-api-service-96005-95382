# Application
APP_ENV=development
LOG_LEVEL=INFO
# Comma separated allowed origins, or leave * for any
# Example: http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ORIGINS=*

# Security: Bearer token required on all endpoints
API_BEARER_TOKEN=changeme-secure-token

# Grafana configuration
GRAFANA_URL=http://localhost:3000
GRAFANA_API_KEY=changeme-grafana-api-key
